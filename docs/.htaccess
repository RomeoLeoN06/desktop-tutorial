# ========================================================
# SARMACI FARUK - PRODUCTION SERVER SECURITY CONFIGURATION
# Apache / LiteSpeed / cPanel Production Rules
# ========================================================

# 1. PREVENT DIRECTORY BROWSING & DISABLE SERVER SIGNATURE
Options -Indexes -MultiViews
ServerSignature Off

# 2. FORCE HTTPS (SSL ENCRYPTION)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# 3. BLOCK SENSITIVE FILES & DIRECTORIES
<FilesMatch "(^\.|\.(env|git|json|lock|yml|yaml|md|config|log|bak|sql|sh))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4. BLOCK DANGEROUS HTTP REQUEST METHODS
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DELETE|PUT) [NC]
    RewriteRule .* - [F]
</IfModule>

# 5. ENTERPRISE HTTP SECURITY HEADERS
<IfModule mod_headers.c>
    # Prevent Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Prevent MIME Type Sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Enable Legacy XSS Filter
    Header always set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy (Stops sensitive URL leakage)
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Restrict Hardware API Access
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    
    # HTTP Strict Transport Security (HSTS - 1 Year + Preload)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Content Security Policy (CSP)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://maps.googleapis.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https: blob:; frame-src 'self' https://www.google.com https://maps.google.com; worker-src 'self' blob:; object-src 'none';"
</IfModule>

# 6. GZIP & BROTLI COMPRESSION (FASTER LOAD & DDOS MITIGATION)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# 7. HIGH-PERFORMANCE ASSET CACHING
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML: Do NOT cache so new deployments appear immediately
    ExpiresByType text/html "access plus 0 seconds"

    # Hashed JS & CSS: 1 Year (Immutable)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Images, Fonts & Media: 1 Year
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Static Assets Cache-Control
    <FilesMatch "\.(css|js|woff2|woff|ttf|png|jpg|jpeg|webp|svg|ico)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # HTML Cache-Control (Freshness Guarantee)
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

# 8. SINGLE PAGE APPLICATION (SPA) FALLBACK ROUTING
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
